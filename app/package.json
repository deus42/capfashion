{
  "name": "capsula-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local personal capsule-wardrobe site (Capsula v1).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite build && node server/index.ts",
    "serve": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test server/",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-serif-display": "^5.3.0",
    "better-auth": "^1.7.15",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
