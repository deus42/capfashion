# Copy to /srv/capsula/capsula.env (chmod 600). Every value without a default is required in production.
NODE_ENV=production
BETTER_AUTH_URL=https://capsula.fit
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
# SIGNUP=open opens sign-up without an invite.
SIGNUP=invite
# Cloudflare Tunnel on the same host: rate limits use CF-Connecting-IP from it.
TRUST_PROXY=cloudflare
OPENAI_API_KEY=
# Model names and prices from the current official OpenAI model and price lists; there are no defaults.
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_PRICES=text_in:,text_out:,image_in:,image_out:,search_call:
OPENAI_TRYON_QUALITY=high
OPENAI_PACKSHOT_QUALITY=medium
MONTHLY_BUDGET_USD=30
MAX_JOBS=2
QUOTA_TRYON=10
QUOTA_PACKSHOT=60
QUOTA_INTAKE=100
QUOTA_STYLING=30
QUOTA_ADVICE=30
QUOTA_TRYON_QUEUE=3
SUPPORT_URL=
